APP_NAME="Coilbox Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8100

LOG_CHANNEL=stack
LOG_LEVEL=debug

# The MariaDB that `scripts/local-services.sh up mariadb` starts. On the droplet
# leave out DB_HOST and DB_PORT and set DB_SOCKET=/run/mysqld/mysqld.sock,
# because the hub user there can only sign in over the socket.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=hub
DB_USERNAME=hub
DB_PASSWORD=hub

# Production uses memcached for both.
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_COOKIE=hub_session

# The Supabase project. The publishable key is public. The service role key
# bypasses row level security and must never be committed.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ASSET_CDN_BASE=https://tomjn.github.io/coilbox-assets/

# The hub's mirror signing key. Generate it with bin/keygen.php in the mirror repository.
HUB_MIRROR_SECRET_KEY=
# HUB_MIRROR_NEXT_SECRET_KEY=
