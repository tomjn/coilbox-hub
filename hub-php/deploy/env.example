APP_NAME="Coilbox Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8100

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite

# Production uses memcached for both.
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_COOKIE=hub_session

# The Supabase project. The publishable key is public. The service role key
# bypasses row level security and must never be committed.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ASSET_CDN_BASE=https://tomjn.github.io/coilbox-assets/
